---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const description =
  'Jorge Guzman’s personal website: mathematics, computational experiments, and visual explanations.';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={description} />
  </head>
  <body>
    <Header />

    <main class="site-main">
      <section class="biography" aria-labelledby="bio-title">
        <img
          class="portrait"
          src="/images/profile-pic.JPG"
          alt="Jorge Guzman"
          width="240"
          height="240"
        />

        <div class="bio-text">
          <h1 id="bio-title">Hi, I’m Jorge Guzman.</h1>

          <p>
            I’m an applied mathematics graduate with interests in topology,
            algebra, dynamical systems, and AI. I enjoy exploring mathematical
            ideas through proofs, code, and visual explanations.
          </p>

          <p>
            Altered Chain is where I share what I’m learning and building,
            from mathematical explanations to computational experiments.
          </p>

          <nav class="bio-links" aria-label="Explore my work">
            <a href="/blog/">Blog</a>
            <a href="/projects/">Projects</a>
          </nav>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .site-main {
    box-sizing: border-box;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }

  .biography {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    align-items: center;
    gap: 3rem;
  }

  .portrait {
    display: block;
    width: 240px;
    height: 240px;
    object-fit: cover;
    object-position: center;
    border-radius: 50%;
  }

  .bio-text h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.2;
  }

  .bio-text p {
    margin: 0 0 1rem;
    line-height: 1.75;
  }

  .bio-links {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .bio-links a {
    font-weight: 600;
    text-underline-offset: 4px;
  }

  @media (max-width: 700px) {
    .site-main {
      padding: 3rem 1.5rem;
    }

    .biography {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .portrait {
      width: 180px;
      height: 180px;
    }
  }
</style>